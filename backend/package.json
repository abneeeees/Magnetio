  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "@supabase/supabase-js": "^2.117.2",
