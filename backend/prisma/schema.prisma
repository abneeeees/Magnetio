// Prisma Schema for Magnetio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String?
  name         String?
  avatarUrl    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  sessions     Session[]
  history      WatchHistory[]
  watchlist    Watchlist[]
  settings     UserSettings?

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model WatchHistory {
  id          String   @id @default(uuid())
  userId      String
  mediaId     String   // IMDb ID (e.g. tt0133093) or TMDB ID
  title       String
  mediaType   String   // "movie" or "series"
  seasonNum   Int?     // For series: season number
  episodeNum  Int?     // For series: episode number
  currentTime Float    @default(0) // Progress in seconds
  duration    Float    @default(0) // Total duration in seconds
  completed   Boolean  @default(false)
  posterUrl   String?
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, seasonNum, episodeNum])
  @@map("watch_history")
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  mediaId   String   // IMDb ID or TMDB ID
  title     String
  mediaType String   // "movie" or "series"
  posterUrl String?
  releaseInfo String?
  addedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@map("watchlist")
}

model UserSettings {
  id               String  @id @default(uuid())
  userId           String  @unique
  defaultQuality   String  @default("1080p") // "4K", "1080p", "720p"
  autoPlayNext     Boolean @default(true)
  subtitlesEnabled Boolean @default(true)
  preferredAudio   String? @default("eng")

  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
